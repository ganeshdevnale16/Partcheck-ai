# ---- Required for saving the AI key on the server (Settings → AI engine → "On the server") ----
ADMIN_KEY=choose-a-long-secret            # also protects /api/logs
# Upstash Redis (Vercel → Storage → Upstash Redis adds these automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: separate secret used to encrypt saved keys (defaults to ADMIN_KEY)
CONFIG_SECRET=

# ---- Optional: put the AI key here instead of in Settings ----
# AI_PROVIDER=gemini                       # azure | openai | gemini | anthropic
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21
